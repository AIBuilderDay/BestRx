# Copy to terraform.tfvars and edit. That file is gitignored — it is per-machine.

prefix      = "bestrx"
environment = "dev"

aws_region  = "us-east-2"
aws_profile = "default"

# Contact for the VAPID `sub` claim, sent to push services so they can reach the operator if this
# server misbehaves. Never shown to users, never verified.
vapid_subject = "mailto:ylim.8299+bestrx-vapid@gmail.com"

# Origins allowed to call the API and open the SSE stream. Add the deployed frontend URL here.
cors_origins = ["http://localhost:5173"]

# Used to build the click-through link inside a notification.
app_url = "http://localhost:5173"

# Leave empty on the first apply. After running backend/scripts/generate_vapid.py, paste the printed
# public key here and apply again.
vapid_public_key = ""
