# Copy to .env.local for local development, or set these in Cloudflare Pages for a deploy.
# Both are read at BUILD time and inlined into the bundle — changing them needs a rebuild.

# Base URL of the API.
#   local docker-compose:  http://localhost:8000
#   deployed on Render:    https://bestrx-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# SSE endpoint. Served by the same process as the API, so it is the API URL plus /stream.
VITE_SSE_URL=http://localhost:8000/stream
