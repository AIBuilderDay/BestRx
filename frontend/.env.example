# BestRx frontend environment
#
# Copy to .env and adjust locally. .env is gitignored; this file is not.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle by Vite.
# Anything you put here ends up in the shipped JavaScript — never put a secret,
# API key, or token in this file.

# Display name used in the app shell.
VITE_APP_NAME=BestRx

# Base URL for the backend API. Empty today: the app reads the mock JSON
# "database" in src/data/ and the backend service is still commented out in
# docker-compose.yml.
VITE_API_BASE_URL=
